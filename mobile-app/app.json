{
  "expo": {
    "name": "My Union Canteen",
    "slug": "my-union-canteen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1E6F5C"
    },
    "android": {
      "package": "com.myunioncanteen.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E6F5C"
      },
      "permissions": ["CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.myunioncanteen.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to scan the canteen QR code."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan the canteen QR code."
        }
      ]
    ]
  }
}
